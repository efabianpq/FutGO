APP_NAME="FutGO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

# ── Producción ────────────────────────────────────────────────────────────────
# APP_NAME="FutGO"
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Producción: LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=futgo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción (app mobile via Capacitor — sesión larga, cookie encriptada):
# SESSION_LIFETIME=10080   (7 días, en minutos)
# SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Storage de medios (avatares, escudos, logos) ──────────────────────────────
# Local (dev): MEDIA_DISK=public
# Producción con Cloudflare R2: MEDIA_DISK=r2
MEDIA_DISK=public

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notificaciones@futgo.co"
MAIL_FROM_NAME="${APP_NAME}"

# Producción (Hostinger SMTP):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=notificaciones@futgo.co
# MAIL_PASSWORD=tu_password_aqui
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="notificaciones@futgo.co"
# MAIL_FROM_NAME="FutGO"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Cloudflare R2 (storage de medios en producción) ───────────────────────────
# Crear bucket en R2, generar API token, y obtener el endpoint del bucket.
# MEDIA_DISK=r2 activa este disco en producción.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
# Endpoint de tu cuenta R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL pública del bucket (dominio personalizado o URL pública de R2):
R2_URL=

# ── Backups (spatie/laravel-backup) ───────────────────────────────────────────
# Contraseña opcional para cifrar los archivos ZIP de backup:
BACKUP_ARCHIVE_PASSWORD=
# Email donde recibir alertas de backup fallido:
BACKUP_NOTIFICATION_EMAIL=admin@tu-dominio.com
# Para subir backups a R2, configurar también las variables R2_* de arriba.
# BACKUP_DISK=r2   (opcional; por defecto solo disco local)

VITE_APP_NAME="${APP_NAME}"

# Centro de Soporte — Gemini AI
GOOGLE_AI_API_KEY=
SUPPORT_CHAT_MODEL=gemini-1.5-flash
SUPPORT_AI_MAX_TOKENS=1000
SUPPORT_TEAM_EMAIL=
SUPPORT_ESCALATION_THRESHOLD=2
SUPPORT_PATTERN_WINDOW_MINUTES=30
SUPPORT_PATTERN_MIN_TICKETS=5
