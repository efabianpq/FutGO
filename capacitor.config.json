{
  "appId": "com.futgo.app",
  "appName": "FutGO",
  "webDir": "public",
  "server": {
    "url": "https://futgo.online",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b0f14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0b0f14"
    }
  },
  "android": {
    "appendUserAgent": "FutGO-Android",
    "webContentsDebuggingEnabled": true
  }
}